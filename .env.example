# A classic or fine-grained PAT with public-repo read access.
# Without it you get 60 API requests/hour; with it, 5000.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Which repo to mine. Change these three to re-point at a different corpus.
REPO_OWNER=vitejs
REPO_NAME=vite
SCOPE_PREFIX=packages/vite/src/

# Where the clone lives (relative to this project unless absolute)
REPO_PATH=repos/vite

# Filters
MAX_GOLD_FILES=10
MIN_BODY_CHARS=80
SINCE_YEARS=3

# --- api (Phase 01) ---
DATABASE_URL=postgresql://triage:triage@localhost:5433/triage
MAX_TOKENS=16000

# "ollama" runs locally and costs nothing. "anthropic" costs money — switch to it
# for gate runs and for Phase 07's quality-per-dollar comparison.
PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Only needed once PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-your-real-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
