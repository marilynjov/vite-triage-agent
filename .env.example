# A classic or fine-grained PAT with public-repo read access.
# Without it you get 60 API requests/hour; with it, 5000.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Which repo to mine. Change these three to re-point at a different corpus.
REPO_OWNER=vitejs
REPO_NAME=vite
SCOPE_PREFIX=packages/vite/src/

# Where the clone lives (relative to this project unless absolute)
REPO_PATH=repos/vite

# Filters
MAX_GOLD_FILES=10
MIN_BODY_CHARS=80
SINCE_YEARS=3
